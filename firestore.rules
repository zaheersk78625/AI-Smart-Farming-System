rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', '') is string)
        && (data.get('photoURL', '') is string);
    }

    function isValidSensorData(data) {
      return data.keys().hasAll(['sensorType', 'value', 'unit', 'timestamp'])
        && data.sensorType is string && data.sensorType.size() <= 50
        && data.value is number
        && data.unit is string && data.unit.size() <= 20
        && data.timestamp is timestamp;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().uid == existing().uid
                     && (!incoming().diff(existing()).affectedKeys().hasAny(['role']));
    }

    match /sensor_data/{readingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSensorData(incoming()) && isValidId(readingId);
    }
    
    match /test/connection {
      allow get: if true;
    }
  }
}
